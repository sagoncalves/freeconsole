---
/**
 * Site footer. Static markup, so it ships in the HTML rather than being appended by JS.
 * Pages that are "a console, not a website" (signup, play) opt out via BaseLayout's
 * `footer={false}`.
 */
---

<footer class="footer" transition:persist>
  <span>FreeConsole — the browser is the screen, phones are the controllers.</span>
  <span class="push faint">No installs. No accounts to play.</span>
</footer>
