---
import BaseLayout from "../layouts/BaseLayout.astro";

/**
 * Sign in / create an account. Nothing else.
 *
 * The catalog editor used to live here too, as a second section this page toggled to once
 * the token came back with the admin claim. That meant the nav's "Admin" link — which only
 * appears when you are already signed in — pointed at a page called "Sign up". The editor is
 * now /admin.html, and this page's only job is to get you authenticated and send you there.
 */
const title = "Sign in — FreeConsole";
const themeColor = "#05060d";
---

<BaseLayout title={title} themeColor={themeColor} footer={false}>
  <Fragment slot="head">
    <style is:global>
      #authView { max-width: 440px; margin: clamp(30px, 8vh, 78px) auto; padding: 0 22px; }
      #authView.hidden { display: none; }

      .auth-head { text-align: center; margin-bottom: 26px; }
      .auth-head h1 { font-size: 27px; margin: 12px 0 7px; }
      .auth-head p { color: var(--text-dim); font-size: 14.5px; margin: 0; }

      .tabs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5px;
        padding: 5px;
        background: rgba(5, 6, 13, 0.6);
        border: 1px solid var(--line);
        border-radius: 11px;
        margin-bottom: 20px;
      }
      .tab {
        padding: 10px;
        border-radius: 8px;
        border: 0;
        background: none;
        color: var(--text-dim);
        font-family: var(--font-display);
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: background .16s, color .16s;
      }
      .tab.active { background: rgba(53, 240, 224, 0.12); color: var(--glow); }

      /* The one-time bootstrap. Deliberately loud: it is the single most consequential
         checkbox in the product, and it only ever appears once. */
      .claim {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        margin: 18px 0 4px;
        padding: 15px;
        border: 1px solid var(--line-bright);
        border-radius: 11px;
        background: linear-gradient(140deg, rgba(53,240,224,.1), rgba(53,240,224,.02));
        position: relative;
        overflow: hidden;
      }
      .claim::before {
        content: "";
        position: absolute; top: 0; left: 0; right: 0; height: 1px;
        background: linear-gradient(to right, transparent, var(--glow), transparent);
      }
      .claim.hidden { display: none; }
      .claim input { width: 18px; height: 18px; margin-top: 2px; accent-color: var(--glow); flex-shrink: 0; }
      .claim-title { font-weight: 700; font-size: 14.5px; color: var(--text); cursor: pointer; }
      .claim-note { font-size: 12px; color: var(--text-dim); margin-top: 4px; line-height: 1.45; }

      .auth-alt { text-align: center; margin-top: 18px; font-size: 13px; color: var(--text-faint); }
    </style>
  </Fragment>

  <main id="main" class="shell">
    <section id="authView">
      <div class="auth-head">
        <a class="brand" href="/" style="justify-content:center">
          <span class="brand-mark" aria-hidden="true">FC</span>
          <span class="brand-name">FreeConsole</span>
        </a>
        <h1 id="authHeading">Admin access</h1>
        <p id="authBlurb">Sign in to manage the game catalog.</p>
      </div>

      <div class="panel panel-lit">
        <div class="tabs" role="tablist">
          <button class="tab active" id="tabSignIn" type="button" role="tab">Sign in</button>
          <button class="tab" id="tabSignUp" type="button" role="tab">Create account</button>
        </div>

        <form id="authForm" autocomplete="on">
          <div class="field">
            <label class="label" for="email">Email</label>
            <input class="input" id="email" type="email" autocomplete="email" placeholder="you@example.com" />
          </div>

          <div class="field">
            <label class="label" for="password">Password</label>
            <input class="input" id="password" type="password" autocomplete="current-password" placeholder="At least 6 characters" />
          </div>

          <div class="claim hidden" id="adminCheckWrap">
            <input type="checkbox" id="asAdmin" />
            <div>
              <label class="claim-title" for="asAdmin">Claim admin access</label>
              <div class="claim-note" id="adminCheckHint">
                No admin exists yet, so this account can claim it. This option disappears
                permanently once someone does.
              </div>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-block btn-lg" id="authSubmit" style="margin-top:18px">Sign in</button>
          <div class="msg" id="authMsg"></div>
        </form>
      </div>

      <p class="auth-alt">
        Just here to play? <a href="/play" data-astro-reload style="color:var(--glow);text-decoration:none">Join a game</a> — no account needed.
      </p>
    </section>
  </main>

  <script type="module">
    import {
      getAuth,
      createUserWithEmailAndPassword,
      signInWithEmailAndPassword,
      onAuthStateChanged,
    } from "https://www.gstatic.com/firebasejs/11.1.0/firebase-auth.js";
    import { getFirestore, doc, getDoc } from "https://www.gstatic.com/firebasejs/11.1.0/firebase-firestore.js";
    import { getFunctions, httpsCallable } from "https://www.gstatic.com/firebasejs/11.1.0/firebase-functions.js";
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.1.0/firebase-app.js";
    import { firebaseConfig } from "/firebase-config.js";
    import { mountAccount } from "/account.js";

    // Initialized directly rather than reusing relay.js: that module also spins up RTDB and the
    // anonymous-auth flow for gameplay, none of which this page needs.
    const app = initializeApp(firebaseConfig);
    mountAccount(app);
    const auth = getAuth(app);
    const firestore = getFirestore(app);
    const functions = getFunctions(app);

    const $ = (id) => document.getElementById(id);

    // Where to go once an admin is signed in. ?next= is only honoured for same-origin paths,
    // so this can't be turned into an open redirect.
    const ADMIN = "/admin";
    const next = (() => {
      const raw = new URLSearchParams(location.search).get("next");
      return raw && /^\/[^/]/.test(raw) ? raw : ADMIN;
    })();

    let mode = "signin";     // or "signup"

    function message(el, kind, text) {
      el.className = "msg show " + kind;
      el.textContent = text;
    }
    const clear = (el) => { el.className = "msg"; };

    // Deliberate pause so a success message is actually readable before the view changes.
    const hold = (ms) => new Promise((r) => setTimeout(r, ms));

    /* ---------------------------------------------------------------- auth screen */

    // The bootstrap option only appears while no admin exists. This is a UI hint only - the
    // real gate is the claimFirstAdmin function, which rejects a second claimant even if
    // someone calls it directly.
    async function adminExists() {
      try {
        const snap = await getDoc(doc(firestore, "admin_meta", "state"));
        return snap.exists() && snap.data().adminExists === true;
      } catch {
        return true; // fail closed: don't offer the bootstrap if we can't tell
      }
    }

    async function refreshAdminCheckbox() {
      const exists = await adminExists();
      const offer = !exists && mode === "signup";
      $("adminCheckWrap").classList.toggle("hidden", !offer);
      if (exists) $("asAdmin").checked = false;

      // On a brand-new install nobody owns the catalog yet, so lead with that rather than
      // making someone guess that "create account" is also the setup step.
      if (!exists) {
        $("authHeading").textContent = mode === "signup" ? "Set up your console" : "Admin access";
        $("authBlurb").textContent = mode === "signup"
          ? "No admin exists yet. The first account can claim the catalog."
          : "Sign in to manage the game catalog.";
        // Nudge a first-time visitor onto the tab that actually does something.
        if (!offer && mode === "signin") $("tabSignUp").classList.add("hint");
      } else {
        $("authHeading").textContent = "Admin access";
        $("authBlurb").textContent = mode === "signup"
          ? "Create an account, then ask an admin to grant you access."
          : "Sign in to manage the game catalog.";
      }
    }

    function setMode(nextMode) {
      mode = nextMode;
      $("tabSignIn").classList.toggle("active", mode === "signin");
      $("tabSignUp").classList.toggle("active", mode === "signup");
      $("authSubmit").textContent = mode === "signin" ? "Sign in" : "Create account";
      $("password").autocomplete = mode === "signin" ? "current-password" : "new-password";
      clear($("authMsg"));
      refreshAdminCheckbox();
    }

    $("tabSignIn").addEventListener("click", () => setMode("signin"));
    $("tabSignUp").addEventListener("click", () => setMode("signup"));

    // Set while a submit is in flight so the onAuthStateChanged handler doesn't navigate away
    // before the success message has been read.
    let submitting = false;

    $("authForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = $("email").value.trim();
      const password = $("password").value;
      const btn = $("authSubmit");

      btn.disabled = true;
      btn.classList.add("loading");
      submitting = true;
      clear($("authMsg"));

      try {
        if (mode === "signup") {
          const wantsAdmin = $("asAdmin").checked && !$("adminCheckWrap").classList.contains("hidden");
          await createUserWithEmailAndPassword(auth, email, password);

          let claimed = false;
          if (wantsAdmin) {
            await httpsCallable(functions, "claimFirstAdmin")({});
            // Custom claims only reach the client on a token refresh.
            await auth.currentUser.getIdToken(true);
            claimed = true;
          }

          btn.classList.remove("loading");
          if (claimed) {
            // This person now owns the catalog, so send them to it rather than home.
            message($("authMsg"), "ok", "Account created — you're the admin. Opening the catalog…");
            await hold(1100);
            location.href = next;
          } else {
            // A plain account can't do anything in the editor yet, so home is the useful
            // destination.
            message($("authMsg"), "ok", "Account created. Taking you home…");
            await hold(1400);
            location.href = "/";
          }
          return;
        }

        await signInWithEmailAndPassword(auth, email, password);
        btn.classList.remove("loading");
        message($("authMsg"), "ok", "Signed in. One moment…");
        await hold(650);
        submitting = false;
        applySession(auth.currentUser);
      } catch (err) {
        submitting = false;
        btn.classList.remove("loading");
        btn.disabled = false;
        message($("authMsg"), "error", friendlyAuthError(err));
      }
    });

    function friendlyAuthError(err) {
      const code = err.code || "";
      if (code.includes("email-already-in-use")) return "That email already has an account. Try signing in.";
      if (code.includes("invalid-credential") || code.includes("wrong-password")) return "Wrong email or password.";
      if (code.includes("user-not-found")) return "No account for that email. Create one first.";
      if (code.includes("weak-password")) return "Password must be at least 6 characters.";
      if (code.includes("invalid-email")) return "That doesn't look like an email address.";
      return err.message || "Something went wrong.";
    }

    /* ---------------------------------------------------------------- session */

    function showAuthView() {
      $("authView").classList.remove("hidden");
      $("authSubmit").disabled = false;
      $("authSubmit").classList.remove("loading");
    }

    /**
     * An admin who lands here is already done - send them to the editor. Everyone else stays
     * on the form, with an explanation if they are signed in but not an admin.
     *
     * Anonymous sessions count as signed out: a player who joined a room has one, and it is
     * never an account.
     */
    async function applySession(user) {
      if (!user || user.isAnonymous) {
        showAuthView();
        setMode(mode);
        return;
      }

      const token = await user.getIdTokenResult().catch(() => null);
      if (token?.claims?.admin === true) {
        location.href = next;
        return;
      }

      showAuthView();
      message(
        $("authMsg"),
        "error",
        "This account isn't an admin yet. Ask an existing admin to grant you access."
      );
    }

    // Account identity and sign-out live in the shared nav (account.js); this only decides
    // whether the form is needed at all. While a submit is in flight the handler owns the
    // transition, so this stays out of the way and lets the success message be read.
    onAuthStateChanged(auth, (user) => {
      if (submitting) return;
      applySession(user);
    });

    setMode("signin");
  </script>
</BaseLayout>
