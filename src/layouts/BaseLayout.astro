---
/**
 * BaseLayout — every page on the platform shares this shell.
 *
 * The nav, footer and atmosphere are server-rendered here as real markup. They used to be
 * built in JS by chrome.js' mountChrome(), which meant every page shipped chrome-less and
 * then grew a nav once that module (and Firebase auth, from a CDN) had loaded — a visible
 * pop-in that also shifted the page, since .nav is position:sticky and reserves no height.
 * None of that markup ever depended on anything but the current path, so none of it needed
 * to be deferred to the client. Only the account slot is still filled in at runtime, by
 * account.js.
 *
 * <ClientRouter /> then keeps navigation from tearing the document down: Astro swaps only
 * the changed part of the page, and the nav/footer carry transition:persist so the very
 * same DOM nodes survive a route change rather than being rebuilt.
 */
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  /** theme-color meta value, defaults to the cabinet near-black. */
  themeColor?: string;
  /** viewport meta; the play page needs a mobile-shaped one. */
  viewport?: string;
  /** mobile-web-app-capable / apple-mobile-web-app-capable meta, on for the join page. */
  appCapable?: boolean;
  /** Extra class on <body> applied at first paint, e.g. bodyClass="in-room" to hide nav. */
  bodyClass?: string;
  /** Signup is an app screen, not a website page, so it opts out of the footer. */
  footer?: boolean;
  /** diag is a bare diagnostics page with none of the cabinet chrome. */
  chrome?: boolean;
}

const {
  title,
  description,
  themeColor = "#05060d",
  viewport = "width=device-width, initial-scale=1",
  appCapable = false,
  bodyClass,
  footer = true,
  chrome = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content={viewport} />
    <meta name="theme-color" content={themeColor} />
    {appCapable && (
      <Fragment>
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
      </Fragment>
    )}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {/*
      console.css is the platform's design system. Loaded from public/ as an absolute
      URL — same as the original HTML files — so the served stylesheet lives at one path
      for every page, every game iframe's <link>, and (importantly) for chrome.js' own
      consumer styles. Kept out of Astro's import graph on purpose: Vite would otherwise
      hash and bundle it, breaking any external reference to /console.css.
    */}
    <link rel="stylesheet" href="/console.css" />
    {/* Per-page inline styles: Astro scopes <style> by default but we want the original
        global rules verbatim, so pages opt into is:global inside their own <style> block. */}
    <slot name="head" />
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    {chrome && (
      <div class="atmosphere" aria-hidden="true" transition:persist></div>
    )}
    {chrome && <Nav />}
    <slot />
    {chrome && footer && <Footer />}
  </body>
</html>
